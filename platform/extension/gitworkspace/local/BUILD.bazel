load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "local.go",
        "runtime.go",
    ],
    importpath = "github.com/uber/submitqueue/platform/extension/gitworkspace/local",
    visibility = ["//visibility:public"],
    deps = [
        "//platform/extension/gitworkspace:go_default_library",
        "//platform/git/exec:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "local_test.go",
        "runtime_test.go",
    ],
    data = [
        "@git",
        "@git//:templates",
        "@git//:templates/description",
    ],
    embed = [":go_default_library"],
    env = {
        "SUBMITQUEUE_TEST_GIT": "$(location @git//:git)",
        "SUBMITQUEUE_TEST_GIT_TEMPLATE_DESCRIPTION": "$(location @git//:templates/description)",
    },
    deps = [
        "//platform/extension/gitworkspace:go_default_library",
        "//platform/git/exectest:go_default_library",
        "@com_github_stretchr_testify//assert:go_default_library",
        "@com_github_stretchr_testify//require:go_default_library",
    ],
)
