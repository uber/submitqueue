{
  "name": "@submitqueue/web-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./path-segment": {
      "types": "./dist/path-segment.d.ts",
      "import": "./dist/path-segment.js"
    },
    "./styles.css": "./styles.css",
    "./logging": {
      "types": "./dist/logging.d.ts",
      "import": "./dist/logging.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.18.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "4.0.7"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  }
}
