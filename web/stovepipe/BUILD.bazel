load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//web/service/submitqueue:eslint/package_json.bzl", eslint = "bin")
load("@npm//web/stovepipe:vitest/package_json.bzl", vitest = "bin")
load("//web/tool:library.bzl", "web_library")

package(default_visibility = ["//web:__subpackages__"])

npm_link_all_packages(name = "node_modules")

web_library(
    assets = [
        "view/styles.css",
        "README.md",
    ],
    eslint = eslint,
    package = "@submitqueue/web-stovepipe",
    test_deps = [
        ":node_modules/@testing-library/jest-dom",
        ":node_modules/@testing-library/react",
        ":node_modules/@types/react-dom",
        ":node_modules/jsdom",
        ":node_modules/react-dom",
        ":node_modules/vitest",
    ],
    vitest = vitest,
    deps = [
        ":node_modules/@opentelemetry/api",
        ":node_modules/@submitqueue/web-platform",
        ":node_modules/@types/node",
        ":node_modules/@types/react",
        ":node_modules/pino",
        ":node_modules/react",
    ],
)
