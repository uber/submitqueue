{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "test-setup.ts",
    "test-render.tsx",
    "vitest.config.ts"
  ]
}
