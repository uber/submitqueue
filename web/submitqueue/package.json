{
  "name": "@submitqueue/web-submitqueue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "server": ["dist/server.d.ts"],
      "extension/gateway/mock": ["dist/extension/gateway/mock/index.d.ts"]
    }
  },
  "sideEffects": [
    "./view/styles.css"
  ],
  "files": [
    "dist",
    "view/styles.css"
  ],
  "exports": {
    "./styles.css": "./view/styles.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./extension/gateway/mock": {
      "types": "./dist/extension/gateway/mock/index.d.ts",
      "import": "./dist/extension/gateway/mock/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "baseui": ">=16 <19",
    "react-dom": ">=18 <20",
    "styletron-react": ">=6",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "baseui": "18.2.0",
    "styletron-engine-atomic": "1.6.2",
    "styletron-react": "6.1.1",
    "@connectrpc/connect": "^2.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.18.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@submitqueue/web-platform": "0.0.0"
  }
}
