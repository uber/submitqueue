{
  "name": "@submitqueue/web-submitqueue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./view/styles.css"
  ],
  "files": [
    "dist",
    "view/styles.css"
  ],
  "exports": {
    "./styles.css": "./view/styles.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./extension/gateway/mock": {
      "types": "./dist/extension/gateway/mock/index.d.ts",
      "import": "./dist/extension/gateway/mock/index.js"
    },
    "./extension/cursor/hmac": {
      "types": "./dist/extension/cursor/hmac/index.d.ts",
      "import": "./dist/extension/cursor/hmac/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9 <2",
    "pino": ">=10 <11",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@connectrpc/connect": "^2.1.1",
    "@opentelemetry/api": "^1.9.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.18.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "pino": "^10.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "4.0.7"
  }
}
