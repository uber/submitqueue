load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//web/service/shared:vitest/package_json.bzl", vitest = "bin")
load("@npm//web/service/submitqueue:eslint/package_json.bzl", eslint = "bin")
load("//web/tool:library.bzl", "web_library")

package(default_visibility = ["//web:__subpackages__"])

npm_link_all_packages(name = "node_modules")

web_library(
    assets = [],
    eslint = eslint,
    package = "@submitqueue/web-service-shared",
    test_deps = [":node_modules/vitest"],
    vitest = vitest,
    deps = [
        ":node_modules/@connectrpc/connect",
        ":node_modules/@connectrpc/connect-node",
        ":node_modules/@submitqueue/web-platform",
        ":node_modules/@types/node",
        ":node_modules/@types/react",
        ":node_modules/next",
        ":node_modules/pino",
        ":node_modules/react",
        ":node_modules/server-only",
    ],
)
