{
  "name": "submitqueue-web-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.20.0 <23",
    "pnpm": ">=10.17.1 <11"
  },
  "scripts": {
    "api:generate": "node ./tool/generate-api.mjs",
    "api:check": "node ./tool/generate-api.mjs --check",
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm api:check && pnpm build && pnpm package:check && pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "playwright test",
    "lint": "pnpm --recursive --if-present run lint",
    "package:check": "node ./tool/check-packages.mjs",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "tsc --project tsconfig.e2e.json && pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@connectrpc/connect": "2.1.1",
    "@connectrpc/connect-node": "2.1.1",
    "@playwright/test": "1.55.1",
    "@submitqueue/api": "workspace:*",
    "@types/node": "22.18.6",
    "typescript": "5.9.3",
    "vitest": "4.0.7"
  }
}
