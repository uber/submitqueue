load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = ["github.go"],
    importpath = "github.com/uber/submitqueue/submitqueue/extension/baserevision/github",
    visibility = ["//visibility:public"],
    deps = [
        "//platform/http:go_default_library",
        "//submitqueue/extension/baserevision:go_default_library",
