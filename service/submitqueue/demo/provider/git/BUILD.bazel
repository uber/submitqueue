"""Demo provider configuration for a plain git remote (no provider).

Consumed by the hermetic git E2E, which bind-mounts this directory into the
orchestrator and runway containers.
"""

filegroup(
    name = "config",
    srcs = [
        "merge.yaml",
        "profiles.tango.yaml",
        "profiles.yaml",
    ],
    visibility = ["//test:__subpackages__"],
)

# Read by the orchestrator's config test, so the profile `ANALYZER=tango`
# mounts is checked against the loader that will read it.
exports_files(
    ["profiles.tango.yaml"],
    visibility = ["//service/submitqueue/orchestrator/server:__pkg__"],
)
