load("@rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library")

go_library(
    name = "go_default_library",
    srcs = ["main.go"],
    importpath = "github.com/uber/submitqueue/service/tangofake/server",
    visibility = ["//visibility:private"],
    deps = [
        "//platform/extension/gitworkspace/local:go_default_library",
        "//service/tangofake:go_default_library",
        "@com_github_uber_tango//tangopb:go_default_library",
        "@org_uber_go_yarpc//:go_default_library",
        "@org_uber_go_yarpc//transport/grpc:go_default_library",
    ],
)

go_binary(
    name = "server",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

# The linux build the e2e suite packs into the fake's image, so no pre-built
# .docker-bin artifact is required.
go_cross_binary(
    name = "tangofake_linux",
    platform = "@rules_go//go/toolchain:linux_amd64",
    target = ":server",
    visibility = ["//test:__subpackages__"],
)

# Everything a Docker-based test needs to build the fake's image from a staged
# build context (see testutil.WithBuildContext).
filegroup(
    name = "docker_test_context",
    testonly = True,
    srcs = [
        "Dockerfile",
        ":tangofake_linux",
    ],
    visibility = ["//test:__subpackages__"],
)
